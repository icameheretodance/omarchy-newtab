#!/bin/bash
# Renders the active Omarchy theme into the extension as colors.css and a
# stable, content-addressed wallpaper. No-op when the fingerprint is unchanged.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

current="$OMARCHY_CURRENT"
theme_dir="$current/theme"
colors_toml="$theme_dir/colors.toml"
theme_name_file="$current/theme.name"
background_file="$current/background"

[[ -f $colors_toml ]] || exit 0
[[ -d $EXTENSION_DIR ]] || exit 0

theme_name="Omarchy"
if [[ -f $theme_name_file ]]; then
  theme_name="$(trim "$(<"$theme_name_file")")"
fi
[[ -n $theme_name ]] || theme_name="Omarchy"

slug="$(printf '%s' "$theme_name" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')"
[[ -n $slug ]] || slug="theme"

background_source=""
if [[ -e $background_file ]]; then
  background_source="$(readlink -f -- "$background_file" 2>/dev/null || true)"
  [[ -f $background_source ]] || background_source=""
fi

fingerprint="${theme_name}|$(stat -c '%Y:%s' -- "$colors_toml" 2>/dev/null || echo 0)|${background_source}|$(stat -c '%Y:%s' -- "${background_source:-/nonexistent}" 2>/dev/null || echo 0)"
fingerprint_file="$EXTENSION_DIR/.theme-fingerprint"

if [[ -f $fingerprint_file && -f $EXTENSION_DIR/colors.css ]] &&
  [[ "$(<"$fingerprint_file")" == "$fingerprint" ]]; then
  exit 0
fi

get_color() {
  local key="$1"
  local fallback="$2"
  local line value

  line="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$colors_toml" | head -n 1 || true)"
  value="${line#*=}"
  value="$(trim "$value")"
  if [[ $value == \"* ]]; then
    value="${value#\"}"
    value="${value%%\"*}"
  elif [[ $value == \'* ]]; then
    value="${value#\'}"
    value="${value%%\'*}"
  else
    value="${value%%[[:space:]]*}"
    value="${value%%#*}"
  fi
  [[ -n $value ]] || value="$fallback"
  printf '%s' "$value"
}

css_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

bg="$(get_color background '#0B0F14')"
bg_darker="$(get_color darker_background "$(get_color dark_background '#030507')")"
bg_light="$(get_color lighter_background "$(get_color dark_background '#121A24')")"
fg="$(get_color foreground '#F1F1F0')"
fg_bright="$(get_color bright_foreground '#F1F1F0')"
fg_muted="$(get_color muted "$(get_color dark_foreground '#7d8590')")"
accent="$(get_color accent "$(get_color green '#5AF78E')")"
selection="$(get_color selection "$(get_color dark_background '#1B2635')")"

wallpaper="none"
image_name=""
if [[ -n $background_source ]]; then
  ext="${background_source##*.}"
  ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  case "$ext" in
  png | jpg | jpeg | webp | gif | avif) ;;
  *) ext="png" ;;
  esac

  hash="$(sha256sum -- "$background_source" | cut -c 1-10)"
  image_name="background-${slug}-${hash}.${ext}"
  cp -f -- "$background_source" "$EXTENSION_DIR/$image_name"
  wallpaper="url(\"$image_name\")"
fi

for old in "$EXTENSION_DIR"/background-*; do
  [[ -e $old ]] || continue
  [[ -n $image_name && $(basename -- "$old") == "$image_name" ]] && continue
  rm -f -- "$old"
done

tmp_css="$EXTENSION_DIR/.colors.css.$$"
trap 'rm -f -- "$tmp_css"' EXIT

cat >"$tmp_css" <<EOF
/* Generated by Omarchy New Tab from the active Omarchy theme. */
:root {
  color-scheme: dark;
  --bg: $bg;
  --bg-darker: $bg_darker;
  --bg-light: $bg_light;
  --fg: $fg;
  --fg-bright: $fg_bright;
  --fg-muted: $fg_muted;
  --accent: $accent;
  --selection: $selection;
  --wallpaper: $wallpaper;
  --theme-name: "$(css_escape "$theme_name")";
}
EOF

mv -f -- "$tmp_css" "$EXTENSION_DIR/colors.css"
trap - EXIT
printf '%s\n' "$fingerprint" >"$fingerprint_file"

exit 0
